import "./array.borth"

# Lexer helper words.
#
# This module is importable library code: it defines words only and has no
# top-level executable test code.
#
# Current lexer scope is deliberately small. It splits source into token strings,
# skips whitespace and comments, and keeps quoted string literals together even
# when they contain spaces.
#
# The lexer does not decode string escape sequences. It only keeps string
# literals together as one token and skips escaped characters while looking for
# the closing quote. The parser turns supported escape sequences into string
# values.

# Lexer State
#
# Lexer state is stored in this array. `file-path` is carried only for lexer
# error messages. `index`, `line`, and `col` are zero-based cursor positions
# while lexing; emitted spans convert line and column numbers to the public
# one-based form.
#
#   [ file-path source index line col tokens spans ]
#
# Accessor and predicate words consume the lexer state they inspect. State
# update words return a new lexer state with one field changed. The main lexer
# loop threads that updated state explicitly.

# lexer-new ( file-path source -- lexer )
#
# Create a lexer for a source string at index 0 with no tokens or spans
# collected. The file path is used when reporting lexer errors.
: lexer-new
  array-new
  rot array-push        # file-path
  swap array-push       # source
  0 array-push          # index
  0 array-push          # line
  0 array-push          # col
  array-new array-push  # tokens
  array-new array-push  # spans
;

# lexer-file-path ( lexer -- file-path )
#
# Return the source path used in lexer error messages.
: lexer-file-path
  0 array-get
;

# lexer-source ( lexer -- source )
: lexer-source
  1 array-get
;

# lexer-index ( lexer -- index )
: lexer-index
  2 array-get
;

# lexer-line ( lexer -- line )
: lexer-line
  3 array-get
;

# lexer-col ( lexer -- col )
: lexer-col
  4 array-get
;

# lexer-tokens ( lexer -- tokens )
: lexer-tokens
  5 array-get
;

# lexer-spans ( lexer -- spans )
: lexer-spans
  6 array-get
;

# lexer-set-file-path ( lexer file-path -- lexer )
#
# Return lexer with a replaced error-reporting file path.
: lexer-set-file-path
  0 swap array-set
;

# lexer-set-source ( lexer source -- lexer )
#
# Return lexer with a replaced source.
: lexer-set-source
  1 swap array-set
;

# lexer-set-index ( lexer index -- lexer )
#
# Return lexer with a replaced source index.
: lexer-set-index
  2 swap array-set
;

# lexer-set-line ( lexer line -- lexer )
#
# Return lexer with a replaced zero-based source line.
: lexer-set-line
  3 swap array-set
;

# lexer-set-col ( lexer col -- lexer )
#
# Return lexer with a replaced zero-based source column.
: lexer-set-col
  4 swap array-set
;

# lexer-set-tokens ( lexer tokens -- lexer )
#
# Return lexer with a replaced token array.
: lexer-set-tokens
  5 swap array-set
;

# lexer-set-spans ( lexer spans -- lexer )
#
# Return lexer with a replaced span array.
: lexer-set-spans
  6 swap array-set
;

# lexer-current-char ( lexer -- char )
#
# Return the one-character string at the current lexer index.
# Caller must check bounds before calling this word.
: lexer-current-char
  dup lexer-source swap lexer-index 1 str-slice
;

# lexer-inc-index ( lexer -- lexer )
#
# Return lexer advanced by one source character.
: lexer-inc-index
  dup lexer-current-char "\n" = if
    dup lexer-line 1 + lexer-set-line
    0 lexer-set-col
  else
    dup lexer-col 1 + lexer-set-col
  end
  dup lexer-index 1 + lexer-set-index
;

# lexer-append-token ( lexer token -- lexer )
#
# Return lexer with token appended to its token array.
: lexer-append-token
  swap dup lexer-tokens
    rot array-push
  lexer-set-tokens
;

# lexer-append-span ( lexer span -- lexer )
#
# Return lexer with span appended to its span array.
: lexer-append-span
  swap dup lexer-spans
    rot array-push
  lexer-set-spans
;

# Lexer Utils

# lexer-record-token-start ( lexer -- token-start-record )
#
# Return a small record containing the current zero-based source index, line,
# and column. The lexer state itself is consumed.
: lexer-record-token-start
  array-new
  over lexer-index array-push # index-start
  over lexer-line array-push  # line-start
  over lexer-col array-push   # col-start
  nip
;

# lexer-panic ( lexer error-msg -- never )
#
# Prefix error-msg with the lexed file path and current one-based line/column,
# then delegate to host panic to stop execution.
: lexer-panic
  swap dup lexer-file-path " error: " swap str-cat ":" str-cat
  over lexer-line 1 + show str-cat
  ":" str-cat
  over lexer-col 1 + show str-cat
  ": " str-cat
  rot str-cat
  panic
;

# Character Predicates

# lexer-at-end? ( lexer -- flag )
#
# Return 1 when the lexer index is at or past the end of source.
: lexer-at-end?
  dup lexer-source str-len swap lexer-index swap < not
;

# lexer-new-line? ( char -- flag )
#
# Return 1 when char is a newline.
# TODO: Support carriage return too.
: lexer-new-line?
  "\n" =
;

# lexer-whitespace? ( char -- flag )
#
# Return 1 when char is a lexer delimiter.
# Only the plain space character and newline are treated as whitespace for now.
: lexer-whitespace?
  dup " " = swap lexer-new-line? or
;

# lexer-quote? ( char -- flag )
#
# Return 1 when char is a double quote.
: lexer-quote?
  "\"" =
;

# Cursor Predicates

# lexer-at-word-end? ( lexer -- flag )
#
# Return 1 when the lexer index is at the end of a non-string token.
# This is a safe predicate: it checks end of source before reading a character.
: lexer-at-word-end?
  dup lexer-at-end? if
    1
  else
    dup lexer-current-char lexer-whitespace? if
      1
    else
      0
    end
  end
  nip
;

# lexer-at-token-start? ( lexer -- flag )
#
# Return 1 when the lexer index points at the start of a token or the end of
# source. This is a safe predicate: it checks end of source before reading a
# character.
: lexer-at-token-start?
  dup lexer-at-end? if
    1
  else
    dup lexer-current-char lexer-whitespace? not if
      1
    else
      0
    end
  end
  nip
;

# lexer-start-of-comment? ( lexer -- flag )
#
# Return 1 when the lexer index points at `#`. Callers should only use this
# after whitespace has been skipped, so `#` is at a token boundary.
: lexer-start-of-comment?
  lexer-current-char "#" =
;

# Cursor Mutation

# lexer-skip-whitespace ( lexer -- lexer )
#
# Return lexer advanced to the first non-whitespace character at or after the
# current index. If only whitespace remains, advance to the end of source.
: lexer-skip-whitespace
  loop
    dup lexer-at-token-start? not
  while
    lexer-inc-index
  repeat
;

# lexer-skip-comment ( lexer -- lexer )
#
# Return lexer advanced just after the next newline, or to the end of source if
# the comment reaches EOF.
: lexer-skip-comment
  loop
    dup lexer-at-end? if
      1
    else
      dup lexer-current-char "\n" = if
        lexer-inc-index 1
      else
        lexer-inc-index 0
      end
    end
  until
;

# Token Readers

# lexer-token-from-start ( lexer token-start-record -- lexer token span )
#
# Return the source slice from the recorded start through the current lexer
# index, plus a one-based `[line-start col-start line-end col-end]` span. The
# end column is exclusive.
: lexer-token-from-start
  # get token
  # ( lexer token-start-record -- token-start-record lexer start )
  dup 0 array-get swap -rot
  # ( token-start-record lexer source start length )
  over lexer-source swap 2over lexer-index over -
  # ( token-start-record lexer token )
  str-slice

  # generate span
  # span is in the form [ line-start col-start line-end col-end ]
  # all numbers are 1 indexed
  # ( lexer token span )
  -rot array-new
    2over 1 array-get 1 + array-push  # line-start
    rot 2 array-get 1 + array-push    # col-start
    over lexer-line 1 + array-push    # line-end
    over lexer-col 1 + array-push     # col-end
  rot swap
;

# lexer-read-word-token ( lexer -- lexer token span )
#
# Return lexer advanced past the current non-string token, plus the token text
# and one-based span. The lexer index must point at the first character of the
# token.
: lexer-read-word-token
  dup lexer-record-token-start swap
  # Skip the first character because index is already known to be inside a word.
  lexer-inc-index
  loop
    dup lexer-at-word-end? not
  while
    lexer-inc-index
  repeat
  swap lexer-token-from-start
;

# lexer-read-string-token ( lexer -- lexer token span )
#
# Return lexer advanced just after the closing quote, plus the full quoted token
# text and one-based span. The lexer index must point at the opening quote.
# Panics if the source ends before a closing quote is found.
: lexer-read-string-token
  dup lexer-record-token-start swap
  # Skip the opening quote before scanning for the closing quote.
  lexer-inc-index

  loop
    dup lexer-at-end? if
      "Unterminated string literal" lexer-panic
    end
    dup lexer-current-char lexer-quote? not
  while
    dup lexer-current-char "\\" = if
      lexer-inc-index # skip escape slash
      dup lexer-at-end? if
        "Unterminated string literal" lexer-panic
      end
    else dup lexer-current-char lexer-new-line? if
      "String literal cannot span lines" lexer-panic
    end end
    lexer-inc-index
  repeat
  lexer-inc-index
  swap lexer-token-from-start
;

# lexer-read-token ( lexer -- lexer token span )
#
# Return lexer advanced past the current token, plus the token text and
# one-based span. Quoted string tokens may contain spaces; other tokens end at
# whitespace.
: lexer-read-token
  dup lexer-current-char lexer-quote? if
    lexer-read-string-token
  else
    lexer-read-word-token
  end
;

# Public API

# lexer-lex-src-file-with-spans ( file-path source -- tokens spans )
#
# Split source into parallel arrays of token strings and one-based token spans.
# The file path is not stored in each span; it is kept in lexer state for error
# messages. A `#` at a token boundary starts a comment that runs through the end
# of the line.
: lexer-lex-src-file-with-spans
  lexer-new
  loop
    dup lexer-at-end? not
  while
    lexer-skip-whitespace
    dup lexer-at-end? not if
      # Comments behave like whitespace once the cursor is between tokens.
      dup lexer-start-of-comment? if
        lexer-skip-comment
      else
        # ( lexer token span )
        lexer-read-token
        -rot lexer-append-token
        swap lexer-append-span
      end
      lexer-skip-whitespace
    end
  repeat
  dup lexer-tokens swap lexer-spans
;


# lexer-lex-src-file ( file-path source -- tokens )
#
# Split source into an array of token strings. A `#` at a token boundary starts
# a comment that runs through the end of the line. The file path is used only
# for lexer error messages.
: lexer-lex-src-file
  lexer-lex-src-file-with-spans drop
;

# lex-src ( source -- tokens )
#
# Backwards-compatible public lexer entry point for callers that only have an
# anonymous source string.
: lex-src
  "unknown" swap lexer-lex-src-file
;
