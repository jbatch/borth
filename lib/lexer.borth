# Lexer helper words.
#
# This module is importable library code: it defines words only and has no
# top-level executable test code.
#
# Current lexer scope is deliberately small. It splits source into token strings,
# skips whitespace and comments, and keeps quoted string literals together even
# when they contain spaces.
#
# String escape sequences are not handled yet.

# Use a global variable for source to make the word contracts much simpler to maintain.
variable lex-source

# lex-char-at ( index -- char )
#
# Return the one-character string at index in lex-source.
# Caller must check bounds before calling this word.
: lex-char-at
  lex-source @ swap 1 str-slice
;

# lex-at-end? ( index -- flag )
#
# Return 1 when index is at or past the end of lex-source.
: lex-at-end?
  lex-source @ str-len < not
;

# lex-new-line? ( char -- flag )
#
# Return 1 when char is a newline.
# TODO: Support carriage return too.
: lex-new-line?
  "\n" =
;

# lex-whitespace? ( char -- flag )
#
# Return 1 when char is a lexer delimiter.
# Only the plain space character and newline are treated as whitespace for now.
: lex-whitespace?
  dup " " = swap lex-new-line? or
;

# lex-quote? ( char -- flag )
#
# Return 1 when char is a double quote.
: lex-quote?
  "\"" =
;

# lex-end-of-word? ( index -- flag )
#
# Return 1 when index is at the end of a non-string token.
# This is a safe predicate: it checks end of source before reading a character.
: lex-end-of-word?
  dup lex-at-end? if
    1
  else
    dup lex-char-at lex-whitespace? if
      1
    else
      0
    end
  end
  nip
;

# lex-end-of-whitespace? ( index -- flag )
#
# Return 1 when index points at the start of a token or the end of source.
# This is a safe predicate: it checks end of source before reading a character.
: lex-end-of-whitespace?
  dup lex-at-end? if
    1
  else
    dup lex-char-at lex-whitespace? not if
      1
    else
      0
    end
  end
  nip
;

# lex-word-end ( index -- end )
#
# Return the exclusive end index of a non-string token.
# index must point at the first character of the token.
: lex-word-end
  # Skip the first character because index is already known to be inside a word.
  1 +
  loop
    dup lex-end-of-word? not
  while
    1 +
  repeat
;

# lex-string-end ( index -- end )
#
# Return the exclusive end index after the closing quote.
# index must point at the opening quote.
# Panics if the source ends before a closing quote is found.
: lex-string-end
  # Skip the opening quote before scanning for the closing quote.
  1 +

  # Check whether the opening quote was the final source character before
  # attempting to read the first string character.
  dup lex-at-end? if
    "Unterminated string literal" panic
  end

  loop
    dup lex-char-at lex-quote? not
  while
    1 +
    dup lex-at-end? if
      "Unterminated string literal" panic
    end
    dup lex-char-at lex-new-line? if
      "String literal cannot span lines" panic
    end
  repeat
  1 +
;

# lex-token-end ( index -- end )
#
# Return the exclusive end index of the token starting at index.
# Quoted string tokens may contain spaces; other tokens end at the next space.
: lex-token-end
  dup lex-char-at lex-quote? if
    lex-string-end
  else
    lex-word-end
  end
;

# lex-token-slice ( start end -- token )
#
# Return the token text between start and end from lex-source.
: lex-token-slice
  over - lex-source @ -rot str-slice
;

# lex-skip-whitespace ( index -- start )
#
# Return the first non-whitespace index at or after index.
# If only whitespace remains, return the end index.
: lex-skip-whitespace
  loop
    dup lex-end-of-whitespace? not
  while
    1 +
  repeat
;

# lex-start-of-comment? ( index -- flag )
#
# Return 1 when index points at `#`. Callers should only use this after
# whitespace has been skipped, so `#` is at a token boundary.
: lex-start-of-comment?
  lex-char-at "#" =
;

# lex-skip-to-new-line ( index -- index )
#
# Return the index just after the next newline, or the source end if the comment
# reaches EOF.
: lex-skip-to-new-line
  # Carry a stop flag so the loop can terminate at newline or EOF.
  # ( index stop? )
  loop
    dup lex-at-end? if
      1
    else
      dup lex-char-at "\n" = if
        # increment index and stop skipping
        1 + 1
      else
        1 + 0
      end
    end
  until
;

# lex-src ( src -- tok-array )
#
# Split the whole source string into an array of token strings. A `#` at a token
# boundary starts a comment that runs through the end of the line.
: lex-src
  # Store src globally so helper words only need to thread the current index.
  lex-source !

  array-new 0
  # ( tok-array index )
  loop
    dup lex-at-end? not
  while
    lex-skip-whitespace
    dup lex-at-end? not if
      # Comments behave like whitespace once the cursor is between tokens.
      dup lex-start-of-comment? if
        lex-skip-to-new-line
      else
        # Read the next token, push it into tok-array, and keep the new index.
        # ( tok-array index -- tok-array end )
        dup lex-token-end dup -rot lex-token-slice rot swap
        array-push swap
      end
      lex-skip-whitespace
    end
  repeat
  drop
;
