import "strings.borth"

# parser-is-string? ( tok -- flag )
#
# Return 1 when tok starts with a double quote.
# The lexer is responsible for keeping the full string literal in one token.
: parser-is-string?
  0 1 str-slice "\"" =
;

# parser-decode-string-token ( token -- value )
#
# Return the decoded value for a string token.
# The input still includes outer quote characters and escape sequences from the
# source token. Supported escapes intentionally match the TypeScript bootstrap
# lexer for now:
#
#   \" -> "
#   \\ -> \
#   \n -> newline
: parser-decode-string-token
  # Set up an accumulator and walk the token from index 1 to len - 1 so the
  # outer quote characters are skipped.
  "" swap 1
  loop
    2dup swap str-len 1 - <
  while
    # acc string index
    2dup 1 str-slice
    dup "\\" = if
      # check next char to see what is being escaped
      # ( acc string index char -- acc string index next-char )
      drop 1 + 2dup 1 str-slice
      dup "n" = if drop
        rot "\n" str-cat -rot
      else dup "\\" = if drop
        rot "\\" str-cat -rot
      else dup "\"" = if drop
        rot "\"" str-cat -rot
      else
        "Unknown escape sequence: \\" swap str-cat panic
      end end end
    else
      # ( acc string index char -- acc string index )
      3 roll swap str-cat -rot
    end
    1 +
  repeat
  drop drop
;

# parse-token ( tok -- [kind value] )
#
# Parse one token string into a small AST node array.
# Current node forms:
#
#   ["integer" value]
#   ["string" value]
#   ["word" name]
#
# String values currently strip the surrounding quotes but do not process escape
# sequences yet.
: parse-token
  array-new over str-int? if
    "integer" array-push swap str-to-int array-push
  else over parser-is-string? if
    "string" array-push swap parser-decode-string-token array-push
  else
    "word" array-push swap array-push
  end end
;

# parse-tokens ( token-array -- node-array )
#
# Parse an array of token strings into an array of AST node arrays.
: parse-tokens
  # ( token-array -- node-array token-array index )
  array-new swap 0
  loop
    over array-len 2dup swap - 0 > nip
  while
    # Get token at index and parse it into a node.
    # ( node-array token-array index -- node-array token-array index node )
    2dup array-get parse-token

    # Push node into node-array and increment index.
    # ( node-array token-array index node -- node-array token-array index )
    3 roll swap array-push 2 -roll 1 +
  repeat
  drop drop
;
