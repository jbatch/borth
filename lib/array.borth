# _array-copy-range-into-builder ( builder array start len -- builder )
#
# Copy len items from array[start,start+len) into builder. The builder is
# mutated internally and returned for further construction.
: _array-copy-range-into-builder
    over + # builder array index end
    loop
        2dup = not
    while
        # ( builder array index end -- builder array end index value )
        swap 2over over array-get

        # Append value, restore builder array index end, then advance index.
        # ( builder array end index value -- builder' array index+1 end )
        4 roll swap array-builder-push 3 -roll swap
        swap 1 + swap
    repeat
    drop drop drop
;

# array-append ( target src -- target )
#
# Append every item from src onto target, preserving item order.
: array-append
    array-builder-new rot
    dup array-len 0 swap _array-copy-range-into-builder
    swap dup array-len 0 swap _array-copy-range-into-builder
    array-builder-freeze
;

# array-last ( array -- value )
#
# Return the final item from an array without changing the array.
: array-last
    dup array-len 1 - array-get
;

# array-pop  ( array -- rest value )
#
# Return a copy of the array without its final item, plus the final item.
# This copies the prefix into a builder so the returned array is still a fresh
# immutable value without rebuilding the prefix after every item.
: array-pop
    dup array-last swap
    array-builder-new swap
    dup array-len 1 - 0 swap _array-copy-range-into-builder
    array-builder-freeze swap
;

# array-valid-index? ( array index -- flag )
#
# Return 1 when index names an existing array item.
# Valid indexes are zero-based: 0 <= index < array-len.
: array-valid-index?
    dup -1 > if
        swap array-len <
    else
        0
    end
;

# _array-assert-valid-range ( array start len -- array start len )
#
# Internal helper for array-slice. It preserves its inputs when the requested
# half-open range is valid:
#
#   start >= 0
#   len >= 0
#   start <= array-len
#   start + len <= array-len
#
# Empty ranges at valid boundaries are allowed, including slicing [] at 0 0.
# Error messages intentionally name array-slice rather than this helper.
: _array-assert-valid-range
    3dup

    # ( array start len )
    over -1 > not if
        "array-slice start must be non-negative" panic
    end

    dup -1 > not if
        "array-slice length must be non-negative" panic
    end

    # ( start len array-len+1 )
    rot array-len 1 +

    # (  len start array-len+1 )
    rot swap 2dup < not if
        "array-slice start is past end of array" panic
    end

    # (  len+start array-len+1 )
    -rot + swap < not if
        "array-slice range is past end of array" panic
    end
;

# array-slice ( array start len -- slice )
#
# Return a new array containing len items from the half-open range:
#
#   [start, start + len)
#
# The input array is not mutated.
: array-slice
    _array-assert-valid-range

    array-builder-new 3 -roll
    _array-copy-range-into-builder
    array-builder-freeze
;

# array-set ( array targetIndex value -- array )
#
# Return a new array with value replacing the item at targetIndex.
# targetIndex must name an existing item; array-set does not append.
# The input array is not mutated.
: array-set
    # check targetIndex is within bounds
    -rot 2dup array-valid-index? not if
        "array-set called with index out of bounds" panic
    end

    #  value array targetIndex prefix
    # copy from 0..targetIndex into prefix
    2dup 0 swap array-slice

    # push value into prefix
    # ( array targetIndex prefix )
    3 roll array-push

    # ( prefix array targetIndex+1 len-target-1 )
    # setup indexes for suffix slice
    -rot over array-len over - 1 - swap 1 + swap

    # copy suffix array into prefix if the slice len is not 0
    dup 0 = not if
        array-slice array-append
    else
        drop drop drop
    end
;
