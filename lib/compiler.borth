import "./array.borth"
import "./map.borth"

# Compiler helper words.
#
# This module compiles the simple AST node arrays produced by parser.borth into
# an inspectable instruction array. Instructions are represented as arrays too:
#
#   ["PUSH" 10]
#   ["ADD"]
#   ["HALT"]
#
# Compilation threads one explicit state object through most compiler words.
# The state object layout is:
#
#   [ nodes node-index instructions allow-top-level-code block-stack words variables ]
#
# `nodes` is the parser output being compiled. `node-index` points at the node
# currently being compiled. `allow-top-level-code` controls whether loose
# executable source is legal outside a definition; imported modules will use 0.
# The remaining fields are mutable compiler-session state: emitted bytecode,
# open control-flow/definition blocks, user-defined word addresses, and variable
# memory indexes.

variable COMPILER_DEBUG

# compiler-new ( node-array allow-top-level-code -- compiler )
#
# Create a new compiler state for one parser node array.
#
# allow-top-level-code is a numeric flag. Entry programs pass 1. Imported
# modules will pass 0 so they can define words and variables without running
# loose stack code at import time.
: compiler-new
    swap
    array-new
    swap array-push         # nodes
    0 array-push            # node-index
    array-new array-push    # instructions
    swap array-push         # allow-top-level-code
    array-new array-push    # block-stack
    map-new array-push      # words
    map-new array-push      # variables
;

# compiler-nodes ( state -- nodes )
: compiler-nodes
    0 array-get
;

# compiler-node-index ( state -- index )
: compiler-node-index
    1 array-get
;

# compiler-instructions ( state -- instructions )
: compiler-instructions
    2 array-get
;

# compiler-allow-top-level-code ( state -- allow-top-level-code )
#
# Return the flag that decides whether executable source is legal outside a
# definition.
: compiler-allow-top-level-code
    3 array-get
;

# compiler-block-stack ( state -- block-stack )
: compiler-block-stack
    4 array-get
;

# compiler-words ( state -- words )
: compiler-words
    5 array-get
;

# compiler-variables ( state -- variables )
: compiler-variables
    6 array-get
;

# compiler-set-nodes ( state nodes -- state )
: compiler-set-nodes
    0 swap array-set
;

# compiler-set-node-index ( state index -- state )
: compiler-set-node-index
    1 swap array-set
;

# compiler-set-instructions ( state instructions -- state )
: compiler-set-instructions
    2 swap array-set
;

# compiler-set-block-stack ( state block-stack -- state )
: compiler-set-block-stack
    4 swap array-set
;

# compiler-set-words ( state words -- state )
: compiler-set-words
    5 swap array-set
;

# compiler-set-variables ( state variables -- state )
: compiler-set-variables
    6 swap array-set
;

# compiler-finished? ( state -- flag )
#
# Return 1 once node-index has reached or passed the number of nodes.
: compiler-finished?
    dup compiler-nodes array-len
    swap compiler-node-index
    swap < not
;

# compiler-increment-node-index ( state -- state )
#
# Move the compiler to the next parser node.
: compiler-increment-node-index
    dup compiler-node-index
        1 +
    compiler-set-node-index
;

# compiler-current-node ( state -- node )
#
# Return the parser node at the current node-index.
: compiler-current-node
    dup compiler-nodes
    swap compiler-node-index array-get
;

# compiler-debug? ( -- flag )
#
# Return 1 when ad hoc compiler trace printing is enabled.
: compiler-debug?
    COMPILER_DEBUG @ 1 =
;


# node-kind ( node -- kind )
#
# Return the kind field from a parser node, such as "integer", "string", or "word".
: node-kind
    0 array-get
;

# node-value ( node -- value )
#
# Return the value field from a parser node.
: node-value
    1 array-get
;

# array-wrap ( value -- array )
#
# Return a new single-item array containing value.
: array-wrap
    array-new swap array-push
;

# emit-instruction ( state instruction -- state )
#
# Append one instruction to compiler-instructions.
: emit-instruction
    swap dup
    # ( instruction state -- instruction state instructions )
    compiler-instructions
        rot array-push
    compiler-set-instructions
;

# compiler-next-instruction-index ( state -- index )
#
# Return the index where the next emitted instruction will be written.
: compiler-next-instruction-index
    compiler-instructions array-len
;

# assert-top-level-code-allowed ( state errorMsg -- )
#
# Panic with errorMsg when compiling an executable node at module top level.
#
# Imported modules should be able to contain definitions, variables, and later
# imports, but they should not run loose stack effects simply because they were
# imported. This helper is the policy gate used before compiling literals and
# executable word nodes.
: assert-top-level-code-allowed
    swap
    dup compiler-allow-top-level-code not if
        # TODO: Replace the block-stack check with an explicit
        # compiler-inside-definition? helper before imports start compiling real
        # module files.
        compiler-block-stack array-len 0 = not if panic end
    else drop end
    drop
;

# patch-instruction ( state index instruction -- state )
#
# Replace an already-emitted instruction. Used for control-flow backpatching.
: patch-instruction
    rot dup
    # ( state index instruction -- state instructions index instruction )
    compiler-instructions
        3 roll 3 roll array-set
    compiler-set-instructions
;

# record-word-name ( state name -- state )
#
# Record a new user-defined word at the current instruction address.
# The name is recorded before the body is compiled so recursive calls can find
# the word currently being defined.
: record-word-name
    # Put the compiler state under the name so the words map can be updated.
    # ( state name -- name state )
    swap dup compiler-words
        rot
        # ( state words name )
        2dup map-has? if
            "word already defined: " swap str-cat panic
        end
        # TODO: Also reject names that collide with compiler-variables or built-in
        # words once the compiler has a single helper for checking the word namespace.
        2over compiler-next-instruction-index map-set
    compiler-set-words
;

# user-defined-word? ( state name -- flag )
#
# Return 1 when name is already known as a user-defined word.
: user-defined-word?
    swap compiler-words swap map-has?
;

# user-defined-word-address ( state name -- address )
#
# Resolve a user-defined word name to its bytecode address.
# Unknown words are compiler errors because forward references are not supported.
: user-defined-word-address
    # Keep a copy of the name for the error message if lookup fails.
    # ( state name -- state name name )
    dup
    # ( state name name -- name value found-flag )
    rot compiler-words swap map-get not if drop
        "Unknown word: " swap show str-cat panic
    end
    nip
;

# user-defined-variable? ( state name -- flag )
#
# Return 1 when name is already known as a user-defined variable.
: user-defined-variable?
    swap compiler-variables swap map-has?
;

# next-variable-index ( state -- index )
#
# Return the memory index that will be assigned to the next variable declaration.
: next-variable-index
    compiler-variables map-size
;

# define-variable ( state name -- state )
#
# Record a user-defined variable name and assign it the next VM memory index.
: define-variable
    # TODO: Reject names that collide with compiler-words, compiler-variables,
    # or built-in words once name availability checking is centralized.
    swap
    # ( state name -- name state variables )
    dup compiler-variables
        # Store the next memory index under the variable name.
        # ( name state variables -- state variables )
        rot 2over next-variable-index map-set
    compiler-set-variables
;

# get-variable-address ( state name -- address )
#
# Resolve a user-defined variable name to its VM memory index.
# Unknown variables are compiler errors because forward references are not supported.
: get-variable-address
    # Keep the variable name for the error message if lookup fails.
    # ( state name -- name value found-flag )
    swap compiler-variables over map-get not if drop
        "Unknown word: " swap show str-cat panic
    end
    nip
;

# push-open-block ( state entry -- state )
#
# Add an open block frame to compiler-block-stack.
# Frames look like ["if" jumpIndex], ["else" jumpIndex], [":" jumpIndex],
# ["loop" startIndex], or ["while" startIndex falseJumpIndex].
: push-open-block
    swap
    # ( state entry -- entry state block-stack )
    dup compiler-block-stack
        rot array-push
    compiler-set-block-stack
;

# pop-open-block ( state -- state blockEntry )
#
# Remove and return the most recently opened block frame.
: pop-open-block
    dup
    # ( state block-stack )
    compiler-block-stack
        array-pop -rot
    compiler-set-block-stack
    swap
;

# pop-expected-open-block ( state expectedKind errorMsg -- state openBlock )
#
# Pop the current block frame and ensure it has the expected kind.
# The caller provides the panic message so each control word can explain what
# kind of closer was missing.
: pop-expected-open-block
    # Bring state to the top so the current block stack can be inspected.
    # ( state expectedKind errorMsg -- expectedKind errorMsg state )
    rot dup
    compiler-block-stack array-len 0 = if
        swap panic
    end
    # ( expectedKind errorMsg state )

    # Get the most recent block frame.
    # ( expectedKind errorMsg state block )
    pop-open-block

    # Compare the block kind with expectedKind.
    # ( expectedKind errorMsg state block -- errorMsg state block )
    3 roll over node-kind = not if
        rot panic
    end
    # Drop errorMessage and return block.
    rot drop
;

# assert-no-open-blocks ( state errorMsg -- )
#
# Ensure every opened control-flow block was closed before HALT is emitted.
: assert-no-open-blocks
    swap compiler-block-stack array-len 0 = not if
        panic
    end
    drop
;

# compile-variable ( state -- state )
#
# Compile a top-level variable declaration.
#
# The current node is expected to be `variable`. This word advances node-index
# to consume the following name node, so the main compile loop will resume after
# the declaration.
# The declaration reserves one VM memory cell at runtime with ALLOC_VARIABLE.
# Later uses of the variable name compile to PUSH of the recorded memory index.
: compile-variable
    dup "variable definitions can only appear at the root level" assert-no-open-blocks

    # TODO: Check that there is a following name node and that it is a word.
    # Move from `variable` to its name node and read that node's value.
    # ( state -- state name )
    compiler-increment-node-index dup compiler-current-node 1 array-get

    # TODO: Reject reserved names once namespace checks are centralized.
    define-variable

    "ALLOC_VARIABLE" array-wrap emit-instruction
;

# compile-if ( state -- state )
#
# Emit a JUMP_IF_FALSE placeholder and remember where it lives.
# The matching end patches that instruction to jump past the true branch.
: compile-if
    # Capture the placeholder's index before emitting it.
    # ( state -- state jumpIfFalseIndex )
    dup compiler-next-instruction-index
    # ( state jumpIfFalseIndex -- jumpIfFalseIndex state )
    "JUMP_IF_FALSE" array-wrap -1 array-push rot swap emit-instruction

    # Remember where the false jump placeholder lives.
    # ( state jumpIfFalseIndex -- state ["if", jumpIfFalseIndex] )
    "if" array-wrap rot array-push
    push-open-block
;

# compile-else ( state -- state )
#
# Close the true branch of an if/else block.
# It emits a JUMP placeholder so the true branch can skip the false branch,
# patches the earlier JUMP_IF_FALSE to land at the false branch, then stores an
# else frame. The matching end patches the JUMP to land after the false branch.
: compile-else
    dup compiler-block-stack array-len 0 = if
        "else without matching if" panic
    end

    # Emit the after-branch JUMP placeholder.
    # Keep its index so the later `end` can patch it.
    # ( state -- afterJumpIndex state )
    dup compiler-next-instruction-index swap
    "JUMP" array-wrap -1 array-push emit-instruction

    # Pop the open if frame.
    # ( afterJumpIndex state -- afterJumpIndex state block )
    pop-open-block

    # A second else sees the previous else frame on top of the block stack.
    dup node-kind "if" = not if
        node-kind "else after " swap str-cat panic
    end

    # Patch the if's false jump to the first instruction of the else branch.
    # ( afterJumpIndex state block -- afterJumpIndex state )
    node-value "JUMP_IF_FALSE" array-wrap 2over compiler-next-instruction-index array-push patch-instruction

    # Store the after-branch jump placeholder for `end`.
    "else" array-wrap rot array-push
    push-open-block
;

# compile-end ( state -- state )
#
# Close an if or if/else block by patching its remaining jump placeholder to the
# next instruction.
: compile-end
    dup compiler-block-stack array-len 0 = if
        "end without matching if" panic
    end

    pop-open-block

    # A plain if frame patches the false jump; an else frame patches the
    # true-branch jump over the else body.
    # ( state block )
    dup node-kind "if" = if
        # Patch the if's jump target to the next instruction.
        # ( state block -- state )
        node-value "JUMP_IF_FALSE" array-wrap 2over compiler-next-instruction-index array-push patch-instruction
    else dup node-kind "else" = if
        # Patch the else's jump target to the next instruction.
        node-value "JUMP" array-wrap 2over compiler-next-instruction-index array-push patch-instruction
    else
        "end without matching if/else" panic
    end end
;

# compile-loop ( state -- state )
#
# Mark the address that a matching until or repeat should jump back to.
: compile-loop
    dup compiler-next-instruction-index
    # ( state startIndex -- state ["loop", startIndex] )
    "loop" array-wrap swap array-push
    push-open-block
;

# compile-until ( state -- state )
#
# Close a post-condition loop. The generated JUMP_IF_FALSE consumes the flag
# left by the loop body and jumps back to the loop start while the flag is 0.
: compile-until
    "loop" "until without matching loop" pop-expected-open-block

    # Get startIndex from the loop block frame.
    # ( state block -- state startIndex )
    node-value

    # Emit ["JUMP_IF_FALSE", startIndex].
    "JUMP_IF_FALSE" array-wrap swap array-push emit-instruction
;

# compile-while ( state -- state )
#
# Split a loop into condition and body. The generated JUMP_IF_FALSE placeholder
# consumes the condition flag and is patched by repeat to exit the loop.
: compile-while
    "loop" "while without matching loop" pop-expected-open-block

    # Read startIndex from the loop frame and capture the placeholder index.
    # ( state block -- state startIndex falseJumpIndex )
    node-value over compiler-next-instruction-index

    # while consumes flag:
    # false -> patched by repeat later
    # true -> fall through to loop body
    # ( state startIndex falseJumpIndex -- startIndex falseJumpIndex state )
    "JUMP_IF_FALSE" array-wrap -1 array-push 3 roll swap emit-instruction

    # ( state ["while", startIndex, falseJumpIndex] )
    -rot "while" array-wrap rot array-push swap array-push
    push-open-block
;

# compile-repeat ( state -- state )
#
# Close a loop/while/repeat block. Emit the back jump, then patch while's false
# jump to the instruction after that back jump.
: compile-repeat
    "while" "repeat without matching while" pop-expected-open-block

    # ( state openBlock -- state startIndex falseJumpIndex )
    dup 2 array-get swap 1 array-get swap

    # Emit ["JUMP", startIndex].
    # ( state startIndex falseJumpIndex -- falseJumpIndex state )
    "JUMP" array-wrap rot array-push rot swap emit-instruction

    # Patch falseJumpIndex to ["JUMP_IF_FALSE", loopEndIndex].
    "JUMP_IF_FALSE" array-wrap over compiler-next-instruction-index array-push rot swap patch-instruction
;


# compile-define ( state -- state )
#
# Start a user-defined word.
# The current node must be `:`. This word advances node-index to consume the
# following name node, so the main compile loop will resume at the first body
# node.
# A JUMP placeholder is emitted so normal execution skips over the definition
# body, and ";" later patches that JUMP to land after the generated RET.
: compile-define
    dup "word definitions can only appear at the root level" assert-no-open-blocks

    # Move from `:` to its name node and read that node's value.
    # ( state -- state word-name )
    compiler-increment-node-index dup compiler-current-node 1 array-get

    # TODO: Reject reserved names once namespace checks are centralized.

    # Emit ["JUMP", -1] to skip the body during normal execution.
    # ( state word-name -- word-name unpatchedJumpIndex state )
    over compiler-next-instruction-index
    "JUMP" array-wrap -1 array-push 3 roll swap emit-instruction
    ":" array-wrap rot array-push
    # ( word-name state -- state )
    push-open-block

    # Record the entry address immediately after the skip jump.
    swap record-word-name
;

# compile-end-definition ( state -- state )
#
# End a user-defined word by emitting RET, closing the ":" frame, and patching
# the earlier skip jump to the first instruction after the word body.
: compile-end-definition
    dup compiler-block-stack array-len 0 = if
        "; without matching :" panic
    end

    "RET" array-wrap emit-instruction
    # ( state -- state block )
    pop-open-block

    dup node-kind ":" = not if
        node-kind "; found with \"" swap str-cat "\" block still open" panic
    end

    # Patch the definition-skipping jump to the end of the word body.
    node-value "JUMP" array-wrap 2over compiler-next-instruction-index array-push patch-instruction
;

# compile-word ( state wordValue -- state )
#
# Compile a word node's value by emitting zero or one instructions.
# Control words may update compiler state instead of emitting normal bytecode.
# Unknown words are fatal compiler errors for now.
: compile-word
    # Arithmetic operations.
    dup "+" = if drop
        "ADD" array-wrap emit-instruction
    else dup "-" = if drop
        "SUB" array-wrap emit-instruction
    else dup "*" = if drop
        "MUL" array-wrap emit-instruction
    else dup "/" = if drop
        "DIV" array-wrap emit-instruction
    else dup "mod" = if drop
        "MOD" array-wrap emit-instruction

    # Boolean comparisons.
    else dup "=" = if drop
        "EQ" array-wrap emit-instruction
    else dup "<" = if drop
        "LT" array-wrap emit-instruction
    else dup ">" = if drop
        "GT" array-wrap emit-instruction

    # Stack operations.
    else dup "drop" = if drop
        "DROP" array-wrap emit-instruction
    else dup "dup" = if drop
        "DUP" array-wrap emit-instruction
    else dup "swap" = if drop
        "SWAP" array-wrap emit-instruction
    else dup "over" = if drop
        "OVER" array-wrap emit-instruction
    else dup "rot" = if drop
        "ROT" array-wrap emit-instruction

    # Memory operations.
     else dup "variable" = if drop
        compile-variable
     else dup "!" = if drop
        "STORE" array-wrap emit-instruction
     else dup "@" = if drop
        "FETCH" array-wrap emit-instruction


    # String operations.
    else dup "str-len" = if drop
        "STR_LEN" array-wrap emit-instruction
    else dup "str-cat" = if drop
        "STR_CAT" array-wrap emit-instruction
    else dup "str-slice" = if drop
        "STR_SLICE" array-wrap emit-instruction
    else dup "str-index-of" = if drop
        "STR_INDEX_OF" array-wrap emit-instruction

    # Array operations.
    else dup "array-new" = if drop
        "ARRAY_NEW" array-wrap emit-instruction
    else dup "array-len" = if drop
        "ARRAY_LEN" array-wrap emit-instruction
    else dup "array-push" = if drop
        "ARRAY_PUSH" array-wrap emit-instruction
    else dup "array-get" = if drop
        "ARRAY_GET" array-wrap emit-instruction

    # Control-flow operations.
    else dup "if" = if drop
        compile-if
    else dup "else" = if drop
        compile-else
    else dup "end" = if drop
        compile-end
    else dup "loop" = if drop
        compile-loop
    else dup "until" = if drop
        compile-until
    else dup "while" = if drop
        compile-while
    else dup "repeat" = if drop
        compile-repeat

    else dup ":" = if drop
        compile-define
    else dup ";" = if drop
        compile-end-definition

    # Utility operations.
    else dup "print" = if drop
        "PRINT" array-wrap emit-instruction
    else dup ".s" = if drop
        "PRINT_STACK" array-wrap emit-instruction
    else dup "show" = if drop
        "SHOW" array-wrap emit-instruction
    else dup "panic" = if drop
        "PANIC" array-wrap emit-instruction

    # Known user-defined words compile to CALL with their recorded bytecode address.
    else
        dup 2over swap  user-defined-word? if
            over swap user-defined-word-address
            "CALL" array-wrap swap array-push emit-instruction
        else dup 2over swap user-defined-variable? if
            over swap get-variable-address
            "PUSH" array-wrap swap array-push emit-instruction
        else
            "Unknown word: " swap show str-cat panic
        end end
    end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end
;

# create-push-instruction ( node -- instruction )
#
# Compile a literal node into a single PUSH instruction.
# The node value is used as-is.
: create-push-instruction
    # ( value ["PUSH"] )
    node-value "PUSH" array-wrap
    # ( ["PUSH" value] )
    swap array-push
;

# compile-literal-node ( state node -- state )
#
# Compile an integer or string node to a PUSH instruction.
#
# Literal nodes are executable code because they push values onto the runtime
# stack, so imported-module mode rejects them at top level.
: compile-literal-node
    over "Imported modules cannot push literals to the stack at the top level" assert-top-level-code-allowed
    create-push-instruction emit-instruction
;

# compile-executable-word-node ( state node -- state )
#
# Compile a word node that has already been classified as executable.
#
# This handles primitive words, control-flow words that operate inside executable
# code, definition terminators, user-defined word calls, and variable address
# pushes. Declaration forms such as `:` and `variable` are intentionally handled
# before this word by compile-word-node.
: compile-executable-word-node
    over "Imported modules cannot call executable words at the top level" assert-top-level-code-allowed
    node-value
    # Arithmetic operations.
    dup "+" = if drop
        "ADD" array-wrap emit-instruction
    else dup "-" = if drop
        "SUB" array-wrap emit-instruction
    else dup "*" = if drop
        "MUL" array-wrap emit-instruction
    else dup "/" = if drop
        "DIV" array-wrap emit-instruction
    else dup "mod" = if drop
        "MOD" array-wrap emit-instruction

    # Boolean comparisons.
    else dup "=" = if drop
        "EQ" array-wrap emit-instruction
    else dup "<" = if drop
        "LT" array-wrap emit-instruction
    else dup ">" = if drop
        "GT" array-wrap emit-instruction

    # Stack operations.
    else dup "drop" = if drop
        "DROP" array-wrap emit-instruction
    else dup "dup" = if drop
        "DUP" array-wrap emit-instruction
    else dup "swap" = if drop
        "SWAP" array-wrap emit-instruction
    else dup "over" = if drop
        "OVER" array-wrap emit-instruction
    else dup "rot" = if drop
        "ROT" array-wrap emit-instruction

    # Memory operations.
     else dup "!" = if drop
        "STORE" array-wrap emit-instruction
     else dup "@" = if drop
        "FETCH" array-wrap emit-instruction


    # String operations.
    else dup "str-len" = if drop
        "STR_LEN" array-wrap emit-instruction
    else dup "str-cat" = if drop
        "STR_CAT" array-wrap emit-instruction
    else dup "str-slice" = if drop
        "STR_SLICE" array-wrap emit-instruction
    else dup "str-index-of" = if drop
        "STR_INDEX_OF" array-wrap emit-instruction

    # Array operations.
    else dup "array-new" = if drop
        "ARRAY_NEW" array-wrap emit-instruction
    else dup "array-len" = if drop
        "ARRAY_LEN" array-wrap emit-instruction
    else dup "array-push" = if drop
        "ARRAY_PUSH" array-wrap emit-instruction
    else dup "array-get" = if drop
        "ARRAY_GET" array-wrap emit-instruction

    # Control-flow operations.
    else dup "if" = if drop
        compile-if
    else dup "else" = if drop
        compile-else
    else dup "end" = if drop
        compile-end
    else dup "loop" = if drop
        compile-loop
    else dup "until" = if drop
        compile-until
    else dup "while" = if drop
        compile-while
    else dup "repeat" = if drop
        compile-repeat

    else dup ";" = if drop
        compile-end-definition

    # Utility operations.
    else dup "print" = if drop
        "PRINT" array-wrap emit-instruction
    else dup ".s" = if drop
        "PRINT_STACK" array-wrap emit-instruction
    else dup "show" = if drop
        "SHOW" array-wrap emit-instruction
    else dup "panic" = if drop
        "PANIC" array-wrap emit-instruction

    # Known user-defined words compile to CALL with their recorded bytecode address.
    else
        dup 2over swap  user-defined-word? if
            over swap user-defined-word-address
            "CALL" array-wrap swap array-push emit-instruction
        else dup 2over swap user-defined-variable? if
            over swap get-variable-address
            "PUSH" array-wrap swap array-push emit-instruction
        else
            "Unknown word: " swap show str-cat panic
        end end
    end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end
;

# compile-word-node ( state node -- state )
#
# Dispatch a parser word node by language role.
#
# Declaration forms can consume extra nodes and are legal at module top level.
# Ordinary executable words are delegated to compile-executable-word-node, which
# enforces the top-level-code mode before emitting bytecode.
: compile-word-node
    dup node-value
    dup ":" = if
        drop drop compile-define
    else dup "variable" = if
        drop drop compile-variable
    else
        drop compile-executable-word-node
    end end
;

# compile-next-node ( state -- state )
#
# Compile the current parser node and advance node-index.
#
# This is the main source-form dispatcher. It chooses literal handling for
# integer/string nodes, word dispatch for word nodes, and reports unknown parser
# node kinds before the loop advances.
: compile-next-node
    dup compiler-current-node
    compiler-debug? if
        "Compiling node" over show str-cat print .s
    end

    dup node-kind
    dup "integer" = if
        drop compile-literal-node
    else dup "string" = if
        drop compile-literal-node
    else dup "word" = if
        drop compile-word-node
    else
        "Unknown node kind: " over show str-cat panic
    end end end

    compiler-increment-node-index
;

# compile-nodes-with-mode ( node-array allow-top-level-code -- instruction-array )
#
# Compile every parser node into one flat instruction stream and append HALT.
#
# This is the configurable entry point used by future import support. Passing 1
# allows normal executable programs. Passing 0 rejects executable source at
# module top level while still allowing declarations.
: compile-nodes-with-mode
    # Initialize compiler state for this compilation.
    0 COMPILER_DEBUG !
    compiler-new

    loop
        dup compiler-finished? not
    while
        compile-next-node
    repeat
    # TODO: Inspect the top open block here so this can report the specific
    # missing closer instead of a generic end-of-source block error.
    dup "unclosed block words after end of source" assert-no-open-blocks
    "HALT" array-wrap emit-instruction
    compiler-instructions
;

# compile-nodes ( node-array -- instruction-array )
#
# Compile parser nodes as a normal entry program.
: compile-nodes
    1 compile-nodes-with-mode
;
