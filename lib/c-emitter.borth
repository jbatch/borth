# First C-backend file emission slice.
#
# This emits one C source file that includes runtime/borth_runtime.h and links
# against runtime/borth_runtime.c.

import "./strings.borth"

variable _C_LABEL_INDEXES
variable _C_SCAN_INDEX

# c-write ( builder contents -- builder )
#
# Append contents to a string builder while keeping the builder on the stack for
# the next emission step.
: c-write
    str-builder-push
;

# c-write-line ( builder contents -- builder )
: c-write-line
    c-write "\n" c-write
;

# c-instruction-op ( instruction -- op )
: c-instruction-op
    0 array-get
;

# c-emit-push-instruction ( instruction -- c-source )
#
# Emit a C helper call for an integer or string PUSH.
: c-emit-push-instruction
    1 array-get show
    dup str-int? if
        "  borth_op_push_int(rt, " swap str-cat ");" str-cat
    else dup "\"" str-starts-with? if
        "  borth_op_push_string(rt, " swap str-cat ");" str-cat
    else
        "C emitter only supports integer and string PUSH for now" panic
    end end
;

# c-label-name ( index -- c-label )
: c-label-name
    show "borth_ip_" swap str-cat
;

# c-emit-label ( index -- c-source )
: c-emit-label
    c-label-name ":" str-cat
;

# c-emit-jump-instruction ( instruction -- c-source )
: c-emit-jump-instruction
    1 array-get c-label-name
    "  goto " swap str-cat ";" str-cat
;

# c-emit-jump-if-false-instruction ( instruction -- c-source )
: c-emit-jump-if-false-instruction
    1 array-get c-label-name
    "  if (!borth_op_pop_condition(rt)) { goto " swap str-cat "; }" str-cat
;

# c-emit-call-instruction ( instruction index -- c-source )
: c-emit-call-instruction
    1 + show
    "  borth_op_push_return(rt, " swap str-cat ");\n  goto " str-cat
    swap 1 array-get c-label-name
    str-cat ";" str-cat
;

# c-emit-record-get-field-instruction ( instruction -- c-source )
: c-emit-record-get-field-instruction
    dup 1 array-get show "  borth_op_record_get_field(rt, " swap str-cat
    ", " str-cat
    over 2 array-get show str-cat
    ", " str-cat
    swap 3 array-get show str-cat
    ");" str-cat
;

# c-emit-record-set-field-instruction ( instruction -- c-source )
: c-emit-record-set-field-instruction
    dup 1 array-get show "  borth_op_record_set_field(rt, " swap str-cat
    ", " str-cat
    over 2 array-get show str-cat
    ", " str-cat
    swap 3 array-get show str-cat
    ");" str-cat
;

# c-record-label-index ( index -- )
#
# Remember that generated control flow can jump to index.
: c-record-label-index
    _C_LABEL_INDEXES @ swap 1 map-set drop
;

# c-collect-label-indexes ( instructions -- instructions )
#
# Collect the bytecode indexes that need C labels: the program entry, explicit
# jump/call targets, and the continuation after each CALL.
: c-collect-label-indexes
    map-new _C_LABEL_INDEXES !
    dup array-len 0 > if
        0 c-record-label-index
    end
    0 _C_SCAN_INDEX !

    loop
        _C_SCAN_INDEX @ over array-len <
    while
        dup _C_SCAN_INDEX @ array-get
        dup c-instruction-op
        dup "CALL" = if
            drop
            dup 1 array-get c-record-label-index
            _C_SCAN_INDEX @ 1 + c-record-label-index
            drop
        else dup "JUMP" = if
            drop 1 array-get c-record-label-index
        else dup "JUMP_IF_FALSE" = if
            drop 1 array-get c-record-label-index
        else
            drop drop
        end end end

        _C_SCAN_INDEX @ 1 + _C_SCAN_INDEX !
    repeat
;

# c-emit-simple-instruction ( instruction -- c-source )
#
# Return the C statement for one supported instruction that does not need the
# current instruction index.
: c-emit-simple-instruction
    dup c-instruction-op
    dup "PUSH" = if
        drop c-emit-push-instruction
    else dup "DROP" = if drop drop "  borth_op_drop(rt);"
    else dup "DUP" = if drop drop "  borth_op_dup(rt);"
    else dup "SWAP" = if drop drop "  borth_op_swap(rt);"
    else dup "OVER" = if drop drop "  borth_op_over(rt);"
    else dup "ROT" = if drop drop "  borth_op_rot(rt);"
    else dup "ROLL" = if drop drop "  borth_op_roll(rt);"
    else dup "ROLL_REVERSE" = if drop drop "  borth_op_roll_reverse(rt);"
    else dup "ADD" = if drop drop "  borth_op_add(rt);"
    else dup "SUB" = if drop drop "  borth_op_sub(rt);"
    else dup "MUL" = if drop drop "  borth_op_mul(rt);"
    else dup "DIV" = if drop drop "  borth_op_div(rt);"
    else dup "MOD" = if drop drop "  borth_op_mod(rt);"
    else dup "EQ" = if drop drop "  borth_op_eq(rt);"
    else dup "LT" = if drop drop "  borth_op_lt(rt);"
    else dup "GT" = if drop drop "  borth_op_gt(rt);"
    else dup "STR_LEN" = if drop drop "  borth_op_str_len(rt);"
    else dup "STR_CAT" = if drop drop "  borth_op_str_cat(rt);"
    else dup "STR_SLICE" = if drop drop "  borth_op_str_slice(rt);"
    else dup "STR_INDEX_OF" = if drop drop "  borth_op_str_index_of(rt);"
    else dup "STR_BUILDER_NEW" = if drop drop "  borth_op_str_builder_new(rt);"
    else dup "STR_BUILDER_PUSH" = if drop drop "  borth_op_str_builder_push(rt);"
    else dup "STR_BUILDER_LEN" = if drop drop "  borth_op_str_builder_len(rt);"
    else dup "STR_BUILDER_FREEZE" = if drop drop "  borth_op_str_builder_freeze(rt);"
    else dup "SHOW" = if drop drop "  borth_op_show(rt);"
    else dup "ARRAY_NEW" = if drop drop "  borth_op_array_new(rt);"
    else dup "ARRAY_PUSH" = if drop drop "  borth_op_array_push(rt);"
    else dup "ARRAY_LEN" = if drop drop "  borth_op_array_len(rt);"
    else dup "ARRAY_GET" = if drop drop "  borth_op_array_get(rt);"
    else dup "ARRAY_BUILDER_NEW" = if drop drop "  borth_op_array_builder_new(rt);"
    else dup "ARRAY_BUILDER_PUSH" = if drop drop "  borth_op_array_builder_push(rt);"
    else dup "ARRAY_BUILDER_LEN" = if drop drop "  borth_op_array_builder_len(rt);"
    else dup "ARRAY_BUILDER_GET" = if drop drop "  borth_op_array_builder_get(rt);"
    else dup "ARRAY_BUILDER_SET" = if drop drop "  borth_op_array_builder_set(rt);"
    else dup "ARRAY_BUILDER_FREEZE" = if drop drop "  borth_op_array_builder_freeze(rt);"
    else dup "MAP_NEW" = if drop drop "  borth_op_map_new(rt);"
    else dup "MAP_GET" = if drop drop "  borth_op_map_get(rt);"
    else dup "MAP_HAS" = if drop drop "  borth_op_map_has(rt);"
    else dup "MAP_SET" = if drop drop "  borth_op_map_set(rt);"
    else dup "MAP_SIZE" = if drop drop "  borth_op_map_size(rt);"
    else dup "RECORD_NEW" = if drop drop "  borth_op_record_new(rt);"
    else dup "RECORD_COPY" = if drop drop "  borth_op_record_copy(rt);"
    else dup "RECORD_GET" = if drop drop "  borth_op_record_get(rt);"
    else dup "RECORD_SET" = if drop drop "  borth_op_record_set(rt);"
    else dup "RECORD_GET_FIELD" = if drop
        c-emit-record-get-field-instruction
    else dup "RECORD_SET_FIELD" = if drop
        c-emit-record-set-field-instruction
    else dup "ALLOC_VARIABLE" = if drop drop "  borth_op_alloc_variable(rt);"
    else dup "FETCH" = if drop drop "  borth_op_fetch(rt);"
    else dup "STORE" = if drop drop "  borth_op_store(rt);"
    else dup "RANDOM" = if drop drop "  borth_op_random(rt);"
    else dup "CLOCK_MS" = if drop drop "  borth_op_clock_ms(rt);"
    else dup "READ_LINE" = if drop drop "  borth_op_read_line(rt);"
    else dup "READ_INT" = if drop drop "  borth_op_read_int(rt);"
    else dup "READ_TEXT_FILE" = if drop drop "  borth_op_read_text_file(rt);"
    else dup "WRITE_TEXT_FILE" = if drop drop "  borth_op_write_text_file(rt);"
    else dup "APPEND_TEXT_FILE" = if drop drop "  borth_op_append_text_file(rt);"
    else dup "FILE_EXISTS" = if drop drop "  borth_op_file_exists(rt);"
    else dup "ENV" = if drop drop "  borth_op_env(rt);"
    else dup "ARGS" = if drop drop "  borth_op_args(rt);"
    else dup "RUN_COMMAND" = if drop drop "  borth_op_run_command(rt);"
    else dup "CWD" = if drop drop "  borth_op_cwd(rt);"
    else dup "PATH_DIRNAME" = if drop drop "  borth_op_path_dirname(rt);"
    else dup "PATH_RESOLVE" = if drop drop "  borth_op_path_resolve(rt);"
    else dup "JUMP" = if drop c-emit-jump-instruction
    else dup "JUMP_IF_FALSE" = if drop c-emit-jump-if-false-instruction
    else dup "PANIC" = if drop drop "  borth_op_panic(rt);"
    else dup "EXIT" = if drop drop "  borth_op_exit(rt);"
    else dup "PRINT_STACK" = if drop drop "  borth_op_print_stack(rt);"
    else dup "PRINT" = if
        drop drop "  borth_op_print(rt);"
    else dup "HALT" = if
        drop drop ""
    else
        "C emitter does not support instruction: " swap str-cat panic
    end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end
;

# c-emit-instruction ( instruction index -- c-source )
#
# Return the C statement for one supported instruction.
: c-emit-instruction
    over c-instruction-op
    dup "CALL" = if
        drop c-emit-call-instruction
    else dup "RET" = if
        drop drop drop "  goto borth_return_dispatch;"
    else
        drop drop c-emit-simple-instruction
    end end
;

# _c-write-line-keep-instruction-loop ( builder instructions index line -- builder instructions index )
#
# Append one generated line while preserving the instruction-loop state.
: _c-write-line-keep-instruction-loop
    3 roll swap c-write 2 -roll
    "\n" 3 roll swap c-write 2 -roll
;

# write-c-instructions ( builder instructions -- builder instructions )
#
# Emit each supported instruction as one C statement.
: write-c-instructions
    0
    loop
        2dup swap array-len <
    while
        _C_LABEL_INDEXES @ over map-has? if
            dup c-emit-label
            _c-write-line-keep-instruction-loop
        end
        2dup array-get over c-emit-instruction
        dup "" = if
            drop
        else
            _c-write-line-keep-instruction-loop
        end
        1 +
    repeat
    drop
;

# c-write-line-with-instructions ( builder instructions contents -- builder instructions )
: c-write-line-with-instructions
    rot swap c-write-line swap
;

# write-c-return-dispatch ( builder instructions -- builder instructions )
#
# Emit the shared return dispatcher used by RET. Only the instruction following
# a CALL can be a valid return address, so omit unreachable switch cases.
: write-c-return-dispatch
    "  if (argc < 0) { goto borth_return_dispatch; }" c-write-line-with-instructions
    "  goto borth_program_end;" c-write-line-with-instructions
    "borth_return_dispatch:" c-write-line-with-instructions
    "  switch (borth_op_pop_return(rt)) {" c-write-line-with-instructions
    0
    loop
        2dup swap array-len <
    while
        2dup array-get c-instruction-op "CALL" = if
            over array-len over 1 + = if
                dup 1 + show
                "    case " swap str-cat ": goto borth_program_end;" str-cat
            else
                dup 1 + show
                "    case " swap str-cat ": goto " str-cat
                over 1 + c-label-name
                str-cat ";" str-cat
            end
            _c-write-line-keep-instruction-loop
        end
        1 +
    repeat
    drop
    "    default: borth_op_invalid_return(rt);" c-write-line-with-instructions
    "  }" c-write-line-with-instructions
    "borth_program_end:" c-write-line-with-instructions
;

# emit-c-program-source ( instructions -- source )
#
# Return one generated C source string for the instruction array.
: emit-c-program-source
    c-collect-label-indexes
    str-builder-new swap
    "#include \"borth_runtime.h\"" c-write-line-with-instructions
    "" c-write-line-with-instructions
    "int main(int argc, char **argv) {" c-write-line-with-instructions
    "  BorthRuntime *rt = borth_runtime_new_with_args(argc - 1, argv + 1);" c-write-line-with-instructions
    dup array-len 0 > if
        "  goto borth_ip_0;" c-write-line-with-instructions
    end
    write-c-instructions
    write-c-return-dispatch
    drop
    "  borth_runtime_free(rt);" c-write-line
    "  return 0;" c-write-line
    "}" c-write-line
    str-builder-freeze
;

# write-c-program ( instructions file-path -- )
#
# Replace file-path with one generated C source file.
: write-c-program
    swap
    emit-c-program-source
    write-text-file
;
