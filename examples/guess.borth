# Guess the number game

# ( target -- target )
: guess-loop
  loop
    "Guess a number between 1-100" print read-int
    over over = if
      "Correct!" print drop 1
    else
      over over < if
        "Lower!" print
      else
        "Higher!" print
      end
      drop 0
    end
  until
;

: main
    1 100 random-between
    guess-loop drop
;

main
