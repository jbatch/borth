# This is an educational proof of concept for how we could implement
# str-int? and str-to-int in Borth rather than as VM primitives.

# digit? ( ch -- flag )
: digit?
  dup "0" = if drop 1 else
  dup "1" = if drop 1 else
  dup "2" = if drop 1 else
  dup "3" = if drop 1 else
  dup "4" = if drop 1 else
  dup "5" = if drop 1 else
  dup "6" = if drop 1 else
  dup "7" = if drop 1 else
  dup "8" = if drop 1 else
  dup "9" = if drop 1 else
    drop 0
  end end end end end end end end end end
;

# char-at ( str index -- char )
#
# Return the one-character string at index, or "" when index is out of bounds.
: char-at
  # Check index is below the string length.
  # ( str index -- str index index-in-bounds )
  over str-len over swap <

  # Check index is not negative.
  # ( str index index-in-bounds -- str index index-in-bounds )
  over 0 < not and

  if
    1 str-slice
  else
    drop drop ""
  end
;

# str-int? ( str -- flag )
: str-int?
  # Empty string and bare "-" are not integers.
  dup "" = not
  over "-" = not
  and if
    # Carry the result flag, source string, and current index.
    # ( str -- flag str index )
    1 swap 0

    # Skip a leading "-".
    2dup char-at "-" = if
      1 +
    end

    loop
      # ( flag str index -- flag str index ch )
      2dup char-at dup "" =
      if
        1
      else
        digit? if
          # Keep the current true/false flag.
        else
          # Replace the carried flag with false.
          rot drop 0 rot rot
        end

        1 +
        0
      end
    until

    # ( flag str index "" -- flag )
    drop drop drop
  else
    drop 0
  end
;

# char-to-int ( ch -- int )
#
# Precondition: ch is a digit.
: char-to-int
  dup "0" = if drop 0 else
  dup "1" = if drop 1 else
  dup "2" = if drop 2 else
  dup "3" = if drop 3 else
  dup "4" = if drop 4 else
  dup "5" = if drop 5 else
  dup "6" = if drop 6 else
  dup "7" = if drop 7 else
  dup "8" = if drop 8 else
  dup "9" = if drop 9 else
    # Defensive fallback for the POC; valid callers should not reach this.
    "char-to-int called with non-digit char" print
    drop 0
  end end end end end end end end end end
;

# str-to-int-from-index ( str index -- int )
#
# Parse a non-negative integer from str, starting at index.
# Precondition: every character from index onward is a digit.
: str-to-int-from-index
  # Start accumulator at 0 below the string and index.
  # ( str index -- acc str index )
  0 2 -roll

  loop
    # ( acc str index -- acc str index ch )
    2dup char-at dup "" = not
    if
      # Move acc to the top, update it, then restore the loop shape.
      # ( acc str index ch -- acc str index )
      char-to-int 3 roll 10 * + 2 -roll

      1 +
      0
    else
      # ( acc str index "" -- acc 1 )
      drop drop drop 1
    end
  until
;

# str-to-int ( str -- int )
#
# Precondition: str has already been validated by str-int?.
: str-to-int
  dup 0 char-at "-" = not if
    0 str-to-int-from-index
  else
    1 str-to-int-from-index -1 *
  end
;

# test-str-int? ( str -- )
: test-str-int?
  dup print "str-int?" print
  str-int? .s drop "" print
;

# test-str-to-int ( str -- )
: test-str-to-int
  dup print "str-to-int" print
  str-to-int .s drop "" print
;

"121" test-str-int?
"-121" test-str-int?
"0" test-str-int?
"abc" test-str-int?
"1h1" test-str-int?
"" test-str-int?
"-" test-str-int?

"" print
"7425" test-str-to-int
"-123" test-str-to-int
